# ================================================
#  SGP · Sistema de Gestión de Proyectos SENA
#  Configuración del entorno (Backend)
#  Copia este archivo como .env y ajusta los valores
#
#  IMPORTANTE: DB_NAME, DB_USER, DB_PASSWORD y DB_PORT deben
#  coincidir con los valores del ".env" en la raíz del repo,
#  ya que ahí es donde se definen las credenciales del
#  contenedor MySQL (ver ../docker-compose.yml).
# ================================================

# ── Servidor ─────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de datos MySQL (contenedor Docker, ver ../docker-compose.yml) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=SistemaGestionProyectosSENA
DB_USER=sgp_user
DB_PASSWORD=changeme_user

# ── JWT ───────────────────────────────────────────
JWT_SECRET=sgp_sena_secreto_super_seguro_2025
JWT_EXPIRES_IN=24h

# ── CORS ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
