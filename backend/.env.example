# --- Correo (recuperación de contraseña) ---
# MAIL_MODE=console imprime el código en la consola del backend (solo desarrollo).
# Para enviar correos reales usa MAIL_MODE=smtp y completa los datos SMTP.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SGP SENA <no-reply@sgpsena.local>
