# SGP SENA - variables del entorno para Docker Compose
# Copia este archivo a ".env" y edita los valores marcados. NO subas ".env" a Git.
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
#
# Reglas para los valores: sin espacios, sin comillas y sin los caracteres $ o #.

# CAMBIAR: contrasenas de MySQL (la de root y la del usuario de la aplicacion)
DB_ROOT_PASSWORD=change_this_root_password
DB_PASSWORD=change_this_user_password

# CAMBIAR: secreto para firmar los JWT, aleatorio y de 32+ caracteres
JWT_SECRET=generate_a_random_secret_at_least_32_characters

# NO CAMBIAR DB_NAME: database/docker-init/001_schema.sql crea la base con este
# nombre fijo, y si difiere el backend no encontrara las tablas.
DB_NAME=SistemaGestionProyectosSENA
DB_USER=sgp_user
DB_PORT=3306

JWT_EXPIRES_IN=2h
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=3000
